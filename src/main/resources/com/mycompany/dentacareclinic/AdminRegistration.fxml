<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.dentacareclinic.AdminRegistrationController">
   <children>
      <VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" spacing="15.0">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="ADMIN REGISTRATION" />

            <!-- FULL NAME -->
            <VBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <Label text="Full Name" />
                  <TextField fx:id="fullNameField" promptText="Enter full name" />
               </children>
            </VBox>

            <!-- USERNAME -->
            <VBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <Label text="Username" />
                  <TextField fx:id="usernameField" promptText="Enter username" />
               </children>
            </VBox>

            <!-- PASSWORD -->
            <VBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <Label text="Password" />
                  <PasswordField fx:id="passwordField" promptText="Enter password" />
               </children>
            </VBox>

            <!-- CONFIRM PASSWORD -->
            <VBox alignment="CENTER_LEFT" spacing="4.0">
               <children>
                  <Label text="Confirm Password" />
                  <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" />
               </children>
            </VBox>

            <!-- BUTTONS -->
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button onAction="#registerAdmin" text="REGISTER" />
                  <Button onAction="#backToLogin" text="BACK TO LOGIN" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>